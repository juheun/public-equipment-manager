# Supabase 프로젝트 설정 → API 메뉴에서 확인할 수 있는 값입니다.
# Vercel에 배포할 때는 Project Settings → Environment Variables에 동일하게 등록하세요.
# 두 값 모두 NEXT_PUBLIC_ 접두사가 붙어 브라우저로 노출되는 값이며,
# 이 프로젝트는 anon key에 RLS(Row Level Security)로 접근을 제한하므로
# service_role 키는 사용하지도, 여기에 두지도 않습니다.

# Supabase 프로젝트 URL (예: https://xxxxxxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon(public) API key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
